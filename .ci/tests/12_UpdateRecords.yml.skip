version: "2"
name: Test Chroma CLI - Update Records (Add with same ID)
testcases:
  - name: Setup - create collection
    steps:
      - type: exec
        script: cmdChroma mkColl t12_update_coll
        assertions:
          - result.code ShouldEqual 0
  - name: Add initial document
    steps:
      - type: exec
        timeout: 120
        script: |
          cmdChroma a t12_update_coll \
            -d "Original content" \
            -d "Second doc" \
            -i "doc-1" \
            -i "doc-2"
        assertions:
          - result.code ShouldEqual 0
          - result.systemout ShouldContainSubstring "Successfully added 2 documents"
  - name: Update document by same ID
    steps:
      - type: exec
        timeout: 120
        script: |
          cmdChroma a t12_update_coll \
            -d "Updated content for doc1" \
            -i "doc-1"
        assertions:
          - result.code ShouldEqual 0
          - result.systemout ShouldContainSubstring "Successfully added 1 document"
  - name: Verify update by listing
    steps:
      - type: exec
        timeout: 60
        script: cmdChroma rs t12_update_coll
        assertions:
          - result.code ShouldEqual 0
          - result.systemout ShouldContainSubstring "Updated content for doc1"
          - result.systemout ShouldContainSubstring "doc-1"
          - result.systemout ShouldContainSubstring "Second doc"
          - result.systemout ShouldContainSubstring "doc-2"
  - name: cleanup
    always: true
    steps:
      - type: exec
        script: cmdChroma delete t12_update_coll || true
        assertions:
          - result.code ShouldEqual 0
