version: "2"
import:
  - _includes/collection_required.yml
  - _includes/file_required.yml
vars:
  cmdChroma: cmdChroma
  subcommand: import-parquet
  collection: test_parquet
  test_file: test_import.parquet

name: Test Chroma CLI - Import Parquet

testcases:
  - name: setup
    steps:
      - type: exec
        script: {{.cmdChroma}} create {{.collection}}
        assertions:
          - result.code ShouldEqual 0
      - type: exec
        script: cp test_data/test_data.parquet {{.test_file}}
        assertions:
          - result.code ShouldEqual 0

  - name: import_success
    steps:
      - type: exec
        timeout: 300
        script: {{.cmdChroma}} import-parquet {{.collection}} {{.test_file}} --id-column "id" --text-column "content" --all-metadata --batch-size 2
        assertions:
          - result.code ShouldEqual 0
          - result.systemout ShouldContainSubstring "Import completed"
      - type: exec
        timeout: 60
        script: {{.cmdChroma}} rs {{.collection}}
        assertions:
          - result.code ShouldEqual 0
          - result.systemout ShouldContainSubstring "parquet-doc-0"
          - result.systemout ShouldContainSubstring "This is Parquet document 0"
          - result.systemout ShouldContainSubstring "metadata-0"

  - name: missing_file
    steps:
      - type: exec
        script: {{.cmdChroma}} import-parquet {{.collection}} nonexistent.parquet
        assertions:
          - result.code ShouldEqual 1
          - result.systemout ShouldContainSubstring "failed to open file"

  - name: missing_column
    steps:
      - type: exec
        script: {{.cmdChroma}} import-parquet {{.collection}} {{.test_file}} --id-column "nonexistent" --text-column "content"
        assertions:
          - result.code ShouldEqual 1
          - result.systemout ShouldContainSubstring "column nonexistent not found"

  - name: cleanup
    always: true
    steps:
      - type: exec
        script: {{.cmdChroma}} delete {{.collection}} || true
        assertions:
          - result.code ShouldEqual 0
      - type: exec
        script: rm -f {{.test_file}}
        assertions:
          - result.code ShouldEqual 0
